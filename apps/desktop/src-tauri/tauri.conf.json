{
  "$schema": "https://raw.githubusercontent.com/nicegui/nicegui/main/tauri/tauri.conf.json",
  "productName": "DeepSeek Harness Desktop",
  "version": "0.1.5-rc.2",
  "identifier": "ai.deepseek.dsh.desktop",
  "build": {
    "frontendDist": "./ui"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DeepSeek Harness Desktop",
        "width": 1400,
        "height": 900,
        "url": "index.html",
        "create": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon-32.png",
      "icons/icon-128.png",
      "icons/icon-256.png",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/desktop-runtime": "desktop-runtime"
    },
    "createUpdaterArtifacts": true,
    "category": "DeveloperTool",
    "copyright": "Copyright © DeepSeek",
    "publisher": "DeepSeek",
    "shortDescription": "DeepSeek Harness desktop shell",
    "longDescription": "DeepSeek Harness Desktop renders the Harness web GUI in the operating system webview and serves it from the packaged desktop Host.",
    "macOS": {
      "minimumSystemVersion": "10.15",
      "hardenedRuntime": true
    },
    "windows": {
      "nsis": {
        "installMode": "both"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [],
      "pubkey": ""
    }
  }
}
