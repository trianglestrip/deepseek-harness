{
  "name": "@deepseek-ai/dsh-desktop",
  "version": "0.1.3-alpha.1",
  "description": "DeepSeek Harness Desktop: Electron shell supervising `dsh --profile desktop`",
  "main": "dist/main.js",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "apps/desktop"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx src/main.ts",
    "dev:tauri": "tauri dev",
    "build": "tsc -p tsconfig.build.json && node -e \"require('node:fs').cpSync('src/window', 'dist/window', { recursive: true })\"",
    "build:tauri": "tauri build",
    "start": "electron .",
    "package:dir": "node packaging/prepare-runtime.mjs && electron-builder --dir",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@deepseek-ai/dsh": "workspace:^",
    "@tauri-apps/cli": "2.11.4",
    "@types/node": "^22.0.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
